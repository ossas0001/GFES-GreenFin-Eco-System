{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gfes-green-consumption-backend",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://gfes-green-consumption.pages.dev/api/auth/google/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gfes-greenfin-eco-system-db",
      "database_id": "b2bcfb09-43ca-4920-92c8-1590a9b60e92",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "gfes-greenfin-eco-system-uploads"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
